# =========================================================================
# GTF VIDEO AI AUTOMATION V2 — Cấu hình hệ thống GTF Video AI Studio V2
# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env.
# =========================================================================

# Provider sinh video ĐANG DÙNG: 'kie' (Kie.ai Seedance 2.5 — MẶC ĐỊNH).
# Các giá trị khác chỉ là fallback không hoạt động: 'mock', 'byteplus', 'openrouter'.
# (Hỗ trợ tương thích ngược với BYTEPLUS_MODE=mock | live)
GTF_VIDEO_PROVIDER=kie
BYTEPLUS_MODE=mock

# Khóa an toàn: khi chạy test tự động luôn là false để không bao giờ tốn credit.
# Chỉ đổi thành true khi người dùng đã cấu hình đầy đủ và sẵn sàng test live.
ALLOW_LIVE_BYTEPLUS_TESTS=false

# Số job sinh video chạy song song tối đa (khuyên dùng 3 cho tài khoản cá nhân, tối đa 10)
BYTEPLUS_MAX_CONCURRENCY=10

# Tốc độ mô phỏng ở chế độ mock (ms cho mỗi chặng pipeline)
BYTEPLUS_MOCK_STAGE_MS=350
BYTEPLUS_MOCK_POLL_MS=120

# =========================================================================
# KIE.AI — LUỒNG ACTIVE (Seedance 2.5)
# Đây là BÍ MẬT DUY NHẤT người dùng cần điền. Điền xong thì khởi động lại server.
# Không cần BytePlus ModelArk / TOS / LAS, không cần OpenRouter.
# =========================================================================
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_VIDEO_MODEL=bytedance/seedance-2-5

KIE_MAX_CONCURRENCY=10
KIE_POLL_INTERVAL_MS=5000
KIE_POLL_TIMEOUT_MS=900000

# Host của File Upload API (tài liệu chính thức: kieai.redpandaai.co)
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
# Thư mục logic chứa file tham chiếu tạm trên Kie
KIE_UPLOAD_PATH=gtf-video-ai
# File tham chiếu trên Kie là TẠM THỜI — hết hạn thì hệ thống tự upload lại từ file gốc
KIE_FILE_TTL_HOURS=24


# =========================================================================
# BÊN DƯỚI LÀ FALLBACK KHÔNG HOẠT ĐỘNG khi GTF_VIDEO_PROVIDER=kie
# Không cần điền bất kỳ giá trị nào.
# =========================================================================

# --- Seedance 1.5 Pro / BytePlus ModelArk ---
# API Key lấy từ BytePlus ModelArk Console > API Key Management
BYTEPLUS_MODELARK_API_KEY=
# Endpoint ID (dạng ep-xxxxxxxx-xxxx) tạo từ ModelArk Console > Online Inference
BYTEPLUS_ENDPOINT_ID=
# Base URL API ModelArk (mặc định khu vực ap-southeast)
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_MODEL_NAME=ByteDance Seedance 1.5 Pro
BYTEPLUS_MODEL_ID=seedance-1-5-pro-251215

# Chu kỳ thăm dò tiến độ (ms) và thời gian chờ tối đa (ms, mặc định 15 phút)
BYTEPLUS_POLL_INTERVAL_MS=5000
BYTEPLUS_POLL_TIMEOUT_MS=900000

# Biến tương thích ngược (nếu không dùng biến mới ở trên)
BYTEPLUS_ARK_API_KEY=
BYTEPLUS_ARK_BASE_URL=

# --- OpenRouter Seedance 2.5 ---
# API Key lấy từ https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.5
OPENROUTER_MAX_CONCURRENCY=1
OPENROUTER_POLL_INTERVAL_MS=5000
OPENROUTER_POLL_TIMEOUT_MS=900000

# --- BytePlus TOS (Torch Object Storage - Lưu trữ ảnh/video tham chiếu) ---
# Lấy Access Key ID và Secret Access Key từ BytePlus IAM / AccessKey Management
BYTEPLUS_TOS_ACCESS_KEY=
BYTEPLUS_TOS_SECRET_KEY=
# Tên Bucket và Vùng (Region) tạo trên BytePlus TOS Console
BYTEPLUS_TOS_BUCKET=gtf-video-reference
BYTEPLUS_TOS_REGION=ap-southeast-1
# Endpoint tùy chọn (mặc định tự suy ra từ Region: https://tos-ap-southeast-1.bytepluses.com)
BYTEPLUS_TOS_ENDPOINT=https://tos-ap-southeast-1.bytepluses.com
# Thời hạn hiệu lực của Signed HTTPS URL (giây, mặc định 3600 = 1 giờ)
BYTEPLUS_TOS_SIGNED_URL_TTL_SECONDS=3600

# --- LAS Asset Library (Kho nhân vật / KOL) ---
BYTEPLUS_LAS_API_KEY=
BYTEPLUS_LAS_ASSET_ENABLED=false

# =========================================================================
# Hệ thống Higgsfield Classic V1 (GIỮ NGUYÊN — KHÔNG THAY ĐỔI)
# =========================================================================
HQ_PORT=20140
CDP_HOST=127.0.0.1
CDP_PORT=9333

